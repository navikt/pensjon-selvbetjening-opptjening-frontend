  "homepage": "/pensjon/opptjening/",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prebuild": "node src/doc/modules/ROOT/doc.js && copyfiles -f src/doc/modules/ROOT/images/*.* public/doc/images",
    "start": "react-scripts start",
    "serve:build": "node expressServer.js",
    "build": "react-scripts build",
    "build:cypress": "REACT_APP_DECORATOR_URL= REACT_APP_REPRESENTASJON_BANNER= react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts",
    "serve:mock": "json-server --port 4000 --watch dev/mock.json",
    "dev": "node scripts/dev.js",
    "cypress:interactive": "cypress open",
    "cy:run:headed": "cypress run --headed --no-exit",
    "testcy:headed": "BROWSER=none start-server-and-test 'pnpm run dev' http://localhost:3000 'pnpm run cy:run:headed'",
    "cy:run": "cypress run --browser chrome",
    "testcy": "BROWSER=none start-server-and-test 'pnpm run serve:build' http-get://127.0.0.1:3000 'pnpm run cy:run'",
    "test:cy:ci": "start-server-and-test 'pnpm run serve:build' http-get://127.0.0.1:3000 'pnpm exec cypress run --browser chrome'",
    "cy:run:update": "cypress run --env updateSnapshots=true",
    "cypress:update": "start-server-and-test dev http://localhost:3000 cy:run:update",
    "express": "node expressServer.js",
    "cypress:docker": "docker run --add-host=host.docker.internal:host-gateway -i -v $PWD:/e2e -w /e2e -e CYPRESS_updateSnapshots=$CYPRESS_updateSnapshots -e CYPRESS_baseUrl=http://host.docker.internal:3000 cypress/included:13.3.1 --browser chrome",
    "cypress:colima": "docker run -i -v $PWD:/e2e -w /e2e -e CYPRESS_updateSnapshots=$CYPRESS_updateSnapshots -e CYPRESS_baseUrl=http://host.lima.internal:3000 cypress/included:13.3.1 --browser chrome",
    "test:cycli": "cross-env start-server-and-test express http://$HOST:3000 cypress:docker",
    "test:cycli:colima": "cross-env start-server-and-test express http://$HOST:3000 cypress:colima",
    "cypress:docker:local": "cross-env HOST=127.0.0.1 npm run test:cycli",
    "cypress:colima:local": "cross-env HOST=127.0.0.1 npm run test:cycli:colima",
    "update:cypress:docker:images": "cross-env HOST=127.0.0.1 CYPRESS_updateSnapshots=true npm run test:cycli",
    "update:cypress:colima:images": "cross-env HOST=127.0.0.1 CYPRESS_updateSnapshots=true npm run test:cycli:colima"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cypress": "~13.3.1",
    "cypress-failed-log": "~2.9.2",
    "cypress-image-snapshot": "4.0.1",

    "jest-axe": "~5.0.1",
    "jest-canvas-mock": "^2.3.0",
    "json-server": "^0.17.4",
    "path": "0.12.7",
    "redux-devtools": "^3.7.0",
    "redux-mock-store": "^1.5.4",
    "start-server-and-test": "3.0.5",
    "typescript": "^3.9.7"
  },
  "pnpm": {
    "overrides": {
      "nth-check@<2.0.1": "2.1.1",
      "axios@<0.31.1": "0.31.1",
      "webpack-dev-server@>=5.0.0 <=5.2.0": "5.2.3",
